{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.ai-video-maker.app",
  "productName": "视频工坊",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "publish": null,
  "files": [
    "out/**/*"
  ],
  "extraResources": [
    {
      "from": "config.json",
      "to": "config.json"
    },
    {
      "from": "default.config",
      "to": "default.config"
    },
    {
      "from": "../tools/dist/video_tools",
      "to": "tools/video_tools",
      "filter": ["**/*"]
    },
    {
      "from": "../tools/dist/image_generator",
      "to": "tools/image_generator",
      "filter": ["**/*"]
    },
    {
      "from": "../tools/dist/text_generator",
      "to": "tools/text_generator",
      "filter": ["**/*"]
    },
    {
      "from": "../tools/dist/speech_recognizer",
      "to": "tools/speech_recognizer",
      "filter": ["**/*"]
    },
    {
      "from": "../tools/dist/runninghub_video",
      "to": "tools/runninghub_video",
      "filter": ["**/*"]
    },
    {
      "from": "../tools/dist/portrait_animator",
      "to": "tools/portrait_animator",
      "filter": ["**/*"]
    },
    {
      "from": "../bin",
      "to": "tools",
      "filter": ["ffmpeg.exe", "ffprobe.exe"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false
  },
  "mac": {
    "target": ["dmg"],
    "icon": "build/icon.icns",
    "category": "public.app-category.video"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "build/icon.png",
    "category": "Video"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "createDesktopShortcut": true
  }
}
