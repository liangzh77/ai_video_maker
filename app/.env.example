# ========================================
# 图片生成配置
# ========================================

# --- 豆包 Doubao ---
DOUBAO_API_KEY=your-doubao-api-key
# 模型列表 (格式: 端点ID:显示名称:能力，能力可选 image/text/image,text，默认 image)
DOUBAO_MODEL_1=your-endpoint-id:Seedream 4.5:image
DOUBAO_MODEL_2=your-endpoint-id:Seedream 4.0:image

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
# 模型列表 (格式: 端点ID:显示名称:能力)
GEMINI_MODEL_1=gemini-3.1-flash-image-preview:Gemini 3.1 Flash Image:image
GEMINI_MODEL_2=gemini-3-pro-image-preview:Nano Banana Pro:image,text
GEMINI_MODEL_3=gemini-2.5-flash-image:Gemini 2.5 Flash:image
GEMINI_MODEL_4=gemini-3.1-pro-preview:Gemini 3.1 Pro:text

# --- 中转 Gemini ---
GEMINI_PROXY_API_KEY=your-gemini-proxy-api-key
# 模型列表 (格式: 端点ID:显示名称:能力)
GEMINI_PROXY_BASE_URL=http://your-proxy-host:port/v1
GEMINI_PROXY_MODEL_1=gemini-3.1-flash-image:Gemini 3.1 Flash Image:image
GEMINI_PROXY_MODEL_2=gemini-3.1-pro-high:Gemini 3.1 Pro:text

# OpenRouter API
OPENROUTER_API_KEY=your-openrouter-api-key
# 模型列表 (格式: 端点ID:显示名称:能力)
OPENROUTER_MODEL_1=google/gemini-3.1-flash-image-preview:Gemini 3.1 Flash Image:image
OPENROUTER_MODEL_2=google/gemini-3-pro-image-preview:Nano Banana Pro:image,text
OPENROUTER_MODEL_3=google/gemini-2.5-flash-image:Gemini 2.5 Flash:image
OPENROUTER_MODEL_4=google/gemini-3.1-pro-preview:Gemini 3.1 Pro:text

# ========================================
# 视频生成配置 (Jimeng API / Seedance 2.0)
# ========================================
JIMENG_API_URL=http://your-jimeng-api-host:port
JIMENG_API_TOKEN=your-jimeng-api-token
