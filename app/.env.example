# ========================================
# 图片生成配置
# ========================================

# --- 豆包 Doubao ---
DOUBAO_API_KEY=your-doubao-api-key
# 模型列表 (格式: 端点ID:显示名称)
DOUBAO_MODEL_1=your-endpoint-id:Seedream 4.5
DOUBAO_MODEL_2=your-endpoint-id:Seedream 4.0

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
# 模型列表 (格式: 端点ID:显示名称)
GEMINI_MODEL_1=gemini-3-pro-image-preview:Nano Banana Pro
GEMINI_MODEL_2=gemini-2.5-flash-image:Gemini 2.5 Flash

# --- 中转 Gemini ---
GEMINI_PROXY_API_KEY=your-gemini-proxy-api-key
# 模型列表 (格式: 端点ID:显示名称)
GEMINI_PROXY_BASE_URL=http://your-proxy-host:port/v1
GEMINI_PROXY_MODEL_1=gemini-3-pro-image:Nano Banana Pro

# OpenRouter API
OPENROUTER_API_KEY=your-openrouter-api-key
# 模型列表 (格式: 端点ID:显示名称)
OPENROUTER_MODEL_1=google/gemini-3-pro-image-preview:Nano Banana Pro
OPENROUTER_MODEL_2=google/gemini-2.5-flash-image:Gemini 2.5 Flash

# ========================================
# 视频生成配置 (Jimeng API / Seedance 2.0)
# ========================================
JIMENG_API_URL=http://your-jimeng-api-host:port
JIMENG_API_TOKEN=your-jimeng-api-token
